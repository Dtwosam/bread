{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true
  },
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/protocol-sdk" },
    { "path": "../../packages/types" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
