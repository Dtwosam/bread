{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    { "path": "../../packages/config" },
    { "path": "../../packages/types" },
    { "path": "../../packages/protocol-sdk" }
  ],
  "include": ["src/**/*.ts"]
}
